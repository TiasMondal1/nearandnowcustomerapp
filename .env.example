# Near & Now customer app — environment template (tracked; NO values live here).
# Copy to `.env` (gitignored) for local work and set the same keys in the EAS dashboard
# (expo.dev → project → Environment Variables) per build profile.
#
# Every key below is read with the static two-layer pattern
#   process.env.EXPO_PUBLIC_X || getAppExtra().x      (lib/appExtra.ts, type AppExtra)
# and mirrored into `extra` by app.config.js. Keep this file, the app.config.js header
# comment and `AppExtra` in sync one-to-one. Only static `process.env.EXPO_PUBLIC_*`
# member expressions are inlined by Metro — dynamic `process.env[name]` never works.
#
# ┌─ WARNING ──────────────────────────────────────────────────────────────────────┐
# │ Never prefix a secret with EXPO_PUBLIC_. Metro inlines every static             │
# │ process.env.EXPO_PUBLIC_* reference into the client bundle, so the value ships  │
# │ to every install the moment any file references it (MAP §7.21).                │
# │                                                                                 │
# │ The repo's local .env currently holds EXPO_PUBLIC_SUPABASE_SERVICE_ROLE_KEY —   │
# │ a server-side secret under the public prefix. The OWNER must rename it (drop    │
# │ the EXPO_PUBLIC_ prefix, or move it out of this client repo); nothing in the    │
# │ app reads it and nothing ever may. Backend-only keys (VITE_*, TWILIO_*,         │
# │ RAZORPAY_*) do not belong in this repo's .env either. Agents never edit .env.   │
# └─────────────────────────────────────────────────────────────────────────────────┘

# Backend REST base URL (lib/apiClient.ts). app.config.js falls back to the production Vercel URL when unset.
EXPO_PUBLIC_API_BASE_URL=

# Supabase project URL — public catalog reads, RPCs and realtime only (lib/supabase.ts).
EXPO_PUBLIC_SUPABASE_URL=

# Supabase ANON key (public, RLS-scoped). Never the service-role key.
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Google Maps key for react-native-maps + reverse geocoding (app.config.js also injects it into the ios/android native map config).
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=

# EAS project id used by getExpoPushTokenAsync(). Optional locally: app.config.js hardcodes the real id as a fallback.
EXPO_PUBLIC_EAS_PROJECT_ID=

# Support phone in E.164 (+91XXXXXXXXXX) for the "Call us" row on settings/support. Empty = the row is not rendered.
EXPO_PUBLIC_SUPPORT_PHONE=

# Support email for support/tracking contact rows. Defaults to support@nearandnow.app in app.config.js when unset.
EXPO_PUBLIC_SUPPORT_EMAIL=

# The literal `true` (case-insensitive) enables Razorpay saved payment methods (lib/razorpayService.ts); anything else = off.
EXPO_PUBLIC_SAVED_METHODS_ENABLED=

# Sentry DSN for app/_layout.tsx Sentry.init. Empty = Sentry disabled (it is also always disabled in __DEV__).
EXPO_PUBLIC_SENTRY_DSN=

# Dev-panel PIN (lib/devFlags.ts). REQUIRED in the EAS production profile — without it the dev panel falls back to the default PIN 7391 (DECISIONS D2); the panel's Env tab shows 'PIN source: default' in red.
EXPO_PUBLIC_DEV_PANEL_PIN=

# Not set here: EAS_BUILD_PROFILE is injected by EAS Build (development | preview | production) and lands in
# extra.buildProfile ("local" when absent); GOOGLE_SERVICES_JSON is an EAS "file" env var. Neither is an EXPO_PUBLIC_ key.
